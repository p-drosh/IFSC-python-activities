n1 = float(input("Type a number please:"))
n2 = float(input("Type another number please:"))

try:
    result = n1/n2
    print(f"The result of {n1}/{n2} is: {result}")
except ZeroDivisionError:
    print("Error: Division by zero is not allowed.")
except ValueError:
    print("Error: invalid input! Please, type a number: ")