import re

def psswval(password):
    if len(password) <= 8:
        raise ValueError("The password must have at least 9 characters. ")
    if not re.search(r'\d', password):
        raise ValueError("The password must have at least 1 number. ")
    if not re.search(r'[A - Z]', password):
        raise ValueError("The password must have at least a uppercase letter. ")

try:
    password = input("Create a password: ")
    psswval(password)
    print("Valid Password.")
except ValueError as e:
    print(e)